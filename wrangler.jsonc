{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catat-saham2",
  "main": "index.js",
  "compatibility_date": "2025-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/healthz"
    ]
  },
  "observability": {
    "enabled": true
  }
}
